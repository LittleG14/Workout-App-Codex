{
  "expo": {
    "name": "Swole House",
    "slug": "swole-house",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-ios.png",
    "scheme": "swolehouse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forge.app",
      "icon": "./assets/images/icon-ios.png"
    },
    "android": {
      "package": "com.forge.app",
      "adaptiveIcon": {
        "backgroundColor": "#E04500",
        "foregroundImage": "./assets/images/icon-ios.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      ["expo-image-picker", { "photosPermission": false, "cameraPermission": false, "microphonePermission": false }],
      ["expo-secure-store", { "faceIDPermission": false, "configureAndroidBackup": true }],
      ["expo-location", {
        "locationWhenInUsePermission": "Swole House uses your location during a run or walk to record your route, distance, and pace.",
        "locationAlwaysAndWhenInUsePermission": "Allow Swole House to continue recording your route, distance, and pace during a run or walk when the screen is locked or you use another app. Tracking stops when you pause or end the workout.",
        "locationAlwaysPermission": false,
        "isIosBackgroundLocationEnabled": true,
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true
      }],
      "./plugins/with-run-background"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
